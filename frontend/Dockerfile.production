# ==========================================
# QueryfyAI Frontend - Production Dockerfile
# ==========================================
# Multi-stage build with security hardening
# Supports: amd64, arm64
# ==========================================

# Build arguments for versioning
ARG BUILD_DATE
ARG VERSION=latest
ARG VCS_REF

# ==========================================
# Stage 1: Dependencies
# ==========================================
FROM node:26-alpine AS deps

WORKDIR /app

# Copy package files for dependency caching
COPY package*.json ./

# Install all dependencies (including dev for build)
RUN npm ci --legacy-peer-deps

# ==========================================
# Stage 2: Builder
# ==========================================
FROM node:26-alpine AS builder

ARG VERSION=latest

WORKDIR /app

# Copy dependencies from deps stage
COPY --from=deps /app/node_modules ./node_modules
COPY . .

# Set version in build
ENV VITE_APP_VERSION=${VERSION}

# Build for production
RUN npm run build

# ==========================================
# Stage 3: Production with unprivileged nginx
# ==========================================
FROM nginxinc/nginx-unprivileged:1.31-alpine AS production

# Build arguments for labels
ARG BUILD_DATE
ARG VERSION=latest
ARG VCS_REF

# OCI Image labels
LABEL org.opencontainers.image.title="QueryfyAI Frontend" \
      org.opencontainers.image.description="Natural Language to SQL Web Interface" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.created="${BUILD_DATE}" \
      org.opencontainers.image.revision="${VCS_REF}" \
      org.opencontainers.image.vendor="QueryfyAI" \
      org.opencontainers.image.source="https://github.com/mkhalid-s/queryfy-ai" \
      org.opencontainers.image.licenses="MIT"

# Copy built assets
COPY --from=builder /app/dist /usr/share/nginx/html

# Copy production nginx config
COPY nginx.production.conf /etc/nginx/conf.d/default.conf

# Create cache directories with proper permissions (nginx-unprivileged runs as user 101)
USER root
RUN mkdir -p /var/cache/nginx/client_temp \
             /var/cache/nginx/proxy_temp \
             /var/cache/nginx/fastcgi_temp \
             /var/cache/nginx/uwsgi_temp \
             /var/cache/nginx/scgi_temp \
    && chown -R 101:101 /var/cache/nginx \
    && chmod -R 755 /var/cache/nginx \
    && chown -R 101:101 /usr/share/nginx/html

# Switch back to unprivileged user
USER 101

# Health check endpoint
HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
    CMD wget --no-verbose --tries=1 --spider http://localhost:8080/health || exit 1

EXPOSE 8080

# Use exec form for proper signal handling
CMD ["nginx", "-g", "daemon off;"]
