# ============================================================================
# QueryfyAI - Development Environment Configuration
# ============================================================================
# Copy this to .env and customize as needed
# Usage: docker compose -f docker-compose.dev.yml --env-file .env up -d
# ============================================================================

# ============================================================================
# APPLICATION
# ============================================================================
APP_NAME=QueryfyAI
DEBUG=true
LOG_LEVEL=DEBUG

# Server (usually not needed in Docker, but available)
HOST=0.0.0.0
PORT=8000

# ============================================================================
# POSTGRESQL (State Persistence)
# ============================================================================
# IMPORTANT: Change the password in production!
POSTGRES_USER=queryfyai
POSTGRES_PASSWORD=changeme
POSTGRES_DB=queryfyai
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}

# ============================================================================
# REDIS (Caching & Rate Limiting)
# ============================================================================
REDIS_URL=redis://redis:6379/0

# ============================================================================
# VECTOR DATABASE
# ============================================================================
# Options: chromadb, qdrant
VECTOR_DB_TYPE=qdrant

# ChromaDB settings (if VECTOR_DB_TYPE=chromadb)
CHROMA_PERSIST_DIR=/app/data/chroma_db
ANONYMIZED_TELEMETRY=False  # Disable ChromaDB PostHog telemetry (causes SSL errors on corporate networks)

# Qdrant settings (if VECTOR_DB_TYPE=qdrant)
QDRANT_URL=http://qdrant:6333
# QDRANT_API_KEY=  # Optional: for Qdrant Cloud

# ============================================================================
# EMBEDDINGS
# ============================================================================
# Options: local, openai, none
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=all-MiniLM-L6-v2
TOKENIZERS_PARALLELISM=false  # Prevent fork warning with Gunicorn workers

# Required if EMBEDDING_PROVIDER=openai
# OPENAI_API_KEY=replace_with_openai_api_key

# ============================================================================
# SESSION MANAGEMENT
# ============================================================================
SESSION_EXPIRY_HOURS=24
TOKEN_REFRESH_BUFFER_SECONDS=300
MAX_CONTEXT_WINDOW=20
MAX_HISTORY_ITEMS=100

# ============================================================================
# SECURITY
# ============================================================================
MAX_QUERY_LENGTH=5000
MAX_SCHEMA_TOKENS=8000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# Session signing secret (IMPORTANT: set this to preserve sessions across restarts)
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
SESSION_SIGNING_SECRET=your-random-64-char-hex-secret-here

# ============================================================================
# QUERY EXECUTION LIMITS
# ============================================================================
QUERY_TIMEOUT_SECONDS=300
MAX_EXPORT_ROWS=1000000
MAX_RESULT_BYTES=524288000  # 500MB in bytes

# ============================================================================
# CACHING CONFIGURATION
# ============================================================================
# Options: auto (Redis if available), redis, memory
CACHE_TYPE=redis
CACHE_TTL_LLM=3600        # 1 hour for LLM responses
CACHE_TTL_QUERY=300       # 5 minutes for query results
CACHE_TTL_SCHEMA=3600     # 1 hour for schema

# ============================================================================
# RATE LIMITING
# ============================================================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT=1000/minute   # Relaxed for development
RATE_LIMIT_LLM=100/minute        # LLM calls
RATE_LIMIT_QUERY=200/minute      # Query execution
RATE_LIMIT_EXPORT=50/minute      # Export operations

# ============================================================================
# SQL AGENT CONFIGURATION (ReAct Agent)
# ============================================================================
AGENT_MAX_RETRIES=3
AGENT_TIMEOUT_SECONDS=120
ANALYST_TIMEOUT_SECONDS=180  # Analyst mode timeout (0 = use standard timeout)

# Agent State Persistence (LangGraph Checkpointer)
# Priority: PostgreSQL > Redis > In-Memory
# - PostgreSQL: Uses DATABASE_URL (recommended for production, horizontal scaling)
# - Redis: Uses REDIS_URL (alternative, if Postgres not available)
# - Memory: Fallback (not suitable for production, no scaling)
AGENT_USE_POSTGRES_STATE=true

# Message History Truncation (prevents context overflow)
# - Preserves: system prompt, original question, and recent messages
# - Truncates: older messages and verbose tool outputs
AGENT_MAX_MESSAGES=50         # Max messages before truncation kicks in
AGENT_PRESERVE_RECENT=20      # Recent messages to always preserve
AGENT_MAX_TOOL_OUTPUT=4000    # Max chars per tool output (truncate if larger)

# ============================================================================
# SCALABILITY / WORKERS
# ============================================================================
WORKERS=1                  # Number of worker processes (0 = auto)
GUNICORN_WORKERS=1         # Same as WORKERS, for gunicorn
GUNICORN_TIMEOUT=600       # Request timeout

# ============================================================================
# LITELLM TELEMETRY
# ============================================================================
# LiteLLM sends anonymous usage analytics to PostHog by default.
# Disable if you're on a corporate network with SSL inspection (causes errors)
# or if you prefer not to send telemetry.
LITELLM_TELEMETRY=False

# ============================================================================
# OPENTELEMETRY (Distributed Tracing)
# ============================================================================
# Enable OpenTelemetry for distributed tracing with Jaeger
OTEL_ENABLED=false         # Set to true to enable tracing
OTEL_SERVICE_NAME=queryfyai-backend
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4317  # Jaeger OTLP gRPC endpoint
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=1.0   # 1.0 = sample all traces, 0.1 = 10%

# ============================================================================
# DEFAULT DATABASE CONFIGURATION (Pre-fill for users)
# ============================================================================
# These defaults appear in the frontend for quick setup
DEFAULT_DB_TYPE=postgresql
# DEFAULT_DB_CONNECTION_URL=postgresql://user:pass@host:5432/dbname
# DEFAULT_DB_NAME=My Database

# ----------------------------------------------------------------------------
# EMBEDDED DATABASES (SQLite, DuckDB) - Important Notes
# ----------------------------------------------------------------------------
# SQLite and DuckDB are embedded databases. The database files must be
# accessible to the backend server process.
#
# WORKS WELL FOR:
#   - Local development and testing
#   - Self-hosted single-user deployments
#   - Demo environments with sample data
#
# FOR DOCKER/KUBERNETES:
#   Mount volumes with your database files:
#   docker run -v /host/data:/app/data ...
#   Then use: sqlite:///app/data/mydb.sqlite
#             duckdb:///app/data/analytics.duckdb
#
# FOR DUCKDB CLOUD (MotherDuck):
#   duckdb:///md:my_database
#
# FOR DUCKDB WITH REMOTE FILES (S3/GCS):
#   duckdb:///s3://bucket/data.parquet
#
# NOT RECOMMENDED FOR:
#   - Multi-tenant SaaS (users can't query their local files from server)
#   - Scenarios where server cannot access the database file path

# ============================================================================
# LLM CONFIGURATION
# ============================================================================
# Choose ONE of the following configurations:

# ----------------------------------------------------------------------------
# OPTION 1: OAuth Gateway (Enterprise Gateway)
# ----------------------------------------------------------------------------
# Use this for corporate OAuth-protected LLM gateways (e.g., Azure AD, Okta)
DEFAULT_LLM_PROVIDER=oauth_gateway

# LLM Gateway Base URL (the AI gateway endpoint)
DEFAULT_LLM_BASE_URL=https://your-ai-gateway.example.com

# OAuth Token URL (where to get access tokens)
# Azure AD example: https://login.microsoftonline.com/{tenant-id}/oauth2/v2.0/token
# Okta example: https://your-org.okta.com/oauth2/default/v1/token
DEFAULT_LLM_TOKEN_URL=https://auth.example.com/oauth2/token

# OAuth Client Credentials
DEFAULT_LLM_CLIENT_ID=your-client-id
DEFAULT_LLM_CLIENT_SECRET=your-client-secret

# OAuth Scope (depends on your gateway configuration)
# Azure AD example: api://your-app-id/.default
# Generic example: openai.chat.completions
DEFAULT_LLM_AUTH_SCOPE=api://your-scope/.default

# OAuth Grant Type (usually client_credentials for server-to-server)
DEFAULT_LLM_AUTH_TYPE=client_credentials

# Tenant ID (for multi-tenant OAuth providers like Azure AD)
DEFAULT_LLM_TENANT=your-tenant-id

# Chat Completions Endpoint (relative to BASE_URL or absolute)
DEFAULT_LLM_CHAT_ENDPOINT=/v1/chat/completions

# Model to use
DEFAULT_LLM_MODEL=gpt-4

# Optional: Custom field for some gateways
# DEFAULT_LLM_STAR=

# ----------------------------------------------------------------------------
# OPTION 2: Direct API (OpenAI)
# ----------------------------------------------------------------------------
# Uncomment these and comment out OAuth settings above
# DEFAULT_LLM_PROVIDER=openai
# DEFAULT_LLM_API_KEY=replace_with_openai_api_key
# DEFAULT_LLM_MODEL=gpt-4

# ----------------------------------------------------------------------------
# OPTION 3: Direct API (Anthropic)
# ----------------------------------------------------------------------------
# DEFAULT_LLM_PROVIDER=anthropic
# DEFAULT_LLM_API_KEY=replace_with_anthropic_api_key
# DEFAULT_LLM_MODEL=claude-sonnet-4-20250514

# ----------------------------------------------------------------------------
# OPTION 4: Azure OpenAI
# ----------------------------------------------------------------------------
# DEFAULT_LLM_PROVIDER=azure
# DEFAULT_LLM_BASE_URL=https://your-resource.openai.azure.com
# DEFAULT_LLM_API_KEY=your-azure-openai-key
# DEFAULT_LLM_MODEL=your-deployment-name

# ----------------------------------------------------------------------------
# OPTION 5: Custom OpenAI-Compatible Endpoint
# ----------------------------------------------------------------------------
# DEFAULT_LLM_PROVIDER=custom
# DEFAULT_LLM_BASE_URL=https://your-custom-endpoint.com
# DEFAULT_LLM_API_KEY=your-api-key
# DEFAULT_LLM_MODEL=your-model-name

# ----------------------------------------------------------------------------
# OPTION 6: AWS Bedrock
# ----------------------------------------------------------------------------
# Uses AWS credentials from environment: AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY
# DEFAULT_LLM_PROVIDER=bedrock
# DEFAULT_LLM_BASE_URL=us-east-1  # AWS region (optional, defaults to us-east-1)
# DEFAULT_LLM_MODEL=anthropic.claude-3-sonnet-20240229-v1:0
# Models: anthropic.claude-3-sonnet-*, anthropic.claude-3-haiku-*, meta.llama3-*

# ----------------------------------------------------------------------------
# OPTION 7: Google Vertex AI
# ----------------------------------------------------------------------------
# Uses Google credentials from: GOOGLE_APPLICATION_CREDENTIALS
# DEFAULT_LLM_PROVIDER=vertex_ai
# DEFAULT_LLM_BASE_URL=your-project-id  # GCP Project ID
# DEFAULT_LLM_API_KEY=us-central1       # Location (region)
# DEFAULT_LLM_MODEL=gemini-1.5-pro

# ----------------------------------------------------------------------------
# OPTION 8: Google Gemini (Direct API)
# ----------------------------------------------------------------------------
# DEFAULT_LLM_PROVIDER=gemini
# DEFAULT_LLM_API_KEY=your-gemini-api-key
# DEFAULT_LLM_MODEL=gemini-1.5-pro
# Models: gemini-1.5-pro, gemini-1.5-flash, gemini-2.0-flash

# ----------------------------------------------------------------------------
# OPTION 9: Groq (Ultra-Fast Inference)
# ----------------------------------------------------------------------------
# DEFAULT_LLM_PROVIDER=groq
# DEFAULT_LLM_API_KEY=your-groq-api-key
# DEFAULT_LLM_MODEL=llama-3.1-70b-versatile
# Models: llama-3.1-70b-versatile, llama-3.1-8b-instant, mixtral-8x7b-32768

# ----------------------------------------------------------------------------
# OPTION 10: Ollama (Local LLM)
# ----------------------------------------------------------------------------
# DEFAULT_LLM_PROVIDER=ollama
# DEFAULT_LLM_BASE_URL=http://localhost:11434  # Ollama server URL
# DEFAULT_LLM_MODEL=llama3
# Models: llama3, mistral, codellama, phi3 (depends on what you've pulled)

# ----------------------------------------------------------------------------
# OPTION 11: Together AI (Open Source Models)
# ----------------------------------------------------------------------------
# DEFAULT_LLM_PROVIDER=together
# DEFAULT_LLM_API_KEY=your-together-api-key
# DEFAULT_LLM_MODEL=meta-llama/Llama-3-70b-chat-hf
# Models: meta-llama/*, mistralai/*, Qwen/*

# ----------------------------------------------------------------------------
# OPTION 12: Mistral AI
# ----------------------------------------------------------------------------
# DEFAULT_LLM_PROVIDER=mistral
# DEFAULT_LLM_API_KEY=your-mistral-api-key
# DEFAULT_LLM_MODEL=mistral-large-latest
# Models: mistral-large-latest, mistral-medium-latest, mistral-small-latest

# ----------------------------------------------------------------------------
# OPTION 13: Cohere
# ----------------------------------------------------------------------------
# DEFAULT_LLM_PROVIDER=cohere
# DEFAULT_LLM_API_KEY=your-cohere-api-key
# DEFAULT_LLM_MODEL=command-r-plus
# Models: command-r-plus, command-r, command-light

# ----------------------------------------------------------------------------
# OPTION 14: DeepSeek
# ----------------------------------------------------------------------------
# DEFAULT_LLM_PROVIDER=deepseek
# DEFAULT_LLM_API_KEY=your-deepseek-api-key
# DEFAULT_LLM_BASE_URL=https://api.deepseek.com  # Optional, defaults to this
# DEFAULT_LLM_MODEL=deepseek-chat
# Models: deepseek-chat, deepseek-coder

# ----------------------------------------------------------------------------
# OPTION 15: Replicate
# ----------------------------------------------------------------------------
# DEFAULT_LLM_PROVIDER=replicate
# DEFAULT_LLM_API_KEY=your-replicate-api-key
# DEFAULT_LLM_MODEL=meta/llama-2-70b-chat


# ============================================================================
# RELIABILITY FEATURE FLAGS
# ============================================================================
#
# Every remediation fix from docs/architecture-audit-2026-04-16.md ships
# behind a boolean flag. All default True in code (enabled). Uncomment &
# set to "false" ONLY for emergency rollback of a specific fix without a
# redeploy. See docs/phase-3-remediation-summary.md for what flipping each
# flag off actually does.
#
# Each flag-off branch reverts to the prior-phase behaviour exactly — no
# hybrid states — so rollback is safe.

# ----------------------------------------------------------------------------
# Phase 1 — demo-breaking bug fixes (analyst-mode reliability)
# ----------------------------------------------------------------------------

# Day 1a — JSON-aware error gate in tool_node (catches success:false
# envelopes the legacy literal-"Error" check missed)
# FIX_JSON_ERROR_DETECTION=true

# Day 1b — check execution_result.success BEFORE status=complete (kills
# the "no results" cascade when a tool self-reports failure)
# FIX_SUCCESS_FIELD_CHECK=true

# Day 2a — attach column_name to every insight (prerequisite for dedup)
# FIX_COLUMN_NAME_FIELD=true

# Day 2b — deduplicate insights by (type, column_name)
# FIX_INSIGHT_DEDUPLICATION=true

# Day 2c — cardinality-aware ID column exclusion (keeps region_id,
# drops policy_id from numeric analysis)
# FIX_SMART_ID_EXCLUSION=true

# Day 2c — use real date ordinals for trends (fixes the
# "policy_id trend 18865%" bug)
# FIX_DATE_BASED_TRENDS=true

# Day 4 — legacy 30s/300s binary timeout split. Superseded by the
# Phase 3a per-DB map when FIX_DB_SPECIFIC_TIMEOUTS is also true.
# FIX_DATA_LAKE_TIMEOUT=true

# ----------------------------------------------------------------------------
# Phase 2 — production-resilience hardening
# ----------------------------------------------------------------------------

# Day 1 — two-counter circuit breaker (exploration ≥10 OR SQL fails ≥3)
# FIX_TWO_COUNTER_CIRCUIT_BREAKER=true

# Day 3 — refuse local-lock fallback in production (requires Redis OR
# DEVELOPMENT_MODE=true)
# FIX_DISTRIBUTED_LOCK_FAIL_LOUD=true

# Day 3 — extend lock in a dedicated asyncio task (not event-driven
# per iteration, which missed quiet periods)
# FIX_BACKGROUND_LOCK_EXTENSION=true

# Day 3 — SELECT 1 preflight on pooled Postgres connections (catches
# dead connections from transient network blips before handing out)
# FIX_POOL_PREFLIGHT=true

# ----------------------------------------------------------------------------
# Phase 3a — data-lake foundation
# ----------------------------------------------------------------------------

# 3a.1 — explicit per-DB tool-execution timeout map (bigquery/hive/spark
# 600s, trino/snowflake/redshift/databricks 300s, athena/clickhouse 180s,
# transactional 30s). AGENT_TOOL_TIMEOUT acts as a floor.
# FIX_DB_SPECIFIC_TIMEOUTS=true

# 3a.2 — emit SSE heartbeat every 15s during quiet periods so corporate
# proxies don't close long-running SSE streams
# FIX_SSE_HEARTBEAT=true

# 3a.3 — detect GROUP BY + aggregate functions; attach "aggregated",
# "grouping_columns", "aggregate_columns" to execution_result
# FIX_AGGREGATION_DETECTION=true

# ----------------------------------------------------------------------------
# Phase 3b — native-async executor plumbing
# ----------------------------------------------------------------------------

# 3b.2 — let async drivers push progress via ToolContext.progress_emitter;
# emits query_progress SSE events (e.g. BigQuery bytes_scanned)
# FIX_QUERY_PROGRESS_EVENTS=true

# ----------------------------------------------------------------------------
# Phase 3c — analytics excellence
# ----------------------------------------------------------------------------

# 3c.1 — aggregated-mode insight thresholds (trend floor 3→5 groups,
# anomaly z-score 3.0→2.0 to compensate for small-N thin tails)
# FIX_AGGREGATED_MODE_THRESHOLDS=true

# 3c.2 — append conditional GROUP BY guidance to the analyst-mode
# system prompt (nudges LLM away from SELECT * for analytical questions)
# FIX_PROMPT_AGGREGATION_HINT=true

# ----------------------------------------------------------------------------
# Phase 4 — size-unbounded analysis (full-dataset insights via Redis cache)
# ----------------------------------------------------------------------------

# 4.0 / 4.1 — store the full row set server-side under a rows_ref handle
# so execute_and_analyze can analyse EVERY row (not a 1000-row sample)
# without blowing past the 50KB tool-payload cap. Frontend fetches the
# rows from /api/v1/results/{rows_ref}; LLM drills in via the new
# get_cached_rows / inspect_cached_result tools. Off → reverts to the
# legacy "1000-row sample + full rows in JSON" path that hit
# "Result too large for processing" on >5K-row queries.
# FIX_RESULT_CACHE=true

# TTL for cached query results. Defaults to 1800s (30 min) — matches
# the default session TTL so a result outlives the conversation turn
# that produced it but not the session. Increase for longer analyst
# sessions; decrease to bound Redis memory usage.
# RESULT_CACHE_TTL_SECONDS=1800

# ----------------------------------------------------------------------------
# Deployment mode
# ----------------------------------------------------------------------------

# Permits process-local asyncio.Lock fallback when Redis is unavailable.
# MUST be false in production (multi-worker deployments without Redis
# cannot serialise concurrent agent runs for the same session and will
# corrupt checkpoint state). Set to true ONLY for dev/test without Redis.
# DEVELOPMENT_MODE=false
