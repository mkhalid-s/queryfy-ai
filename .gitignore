# ==========================================
# QueryfyAI - Root .gitignore
# ==========================================

# ==========================================
# Environment & Secrets
# ==========================================
.env
.env.local
.env.*.local
.env.production
.env.production.*
*.pem
*.key
*.crt
secrets/
software-catalog.yaml
private-catalog*.yaml
private-catalog*.yml

# ==========================================
# Python (Backend)
# ==========================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
env/
.venv/
.pytest-venv/
backend/venv/
backend/.venv/
backend/.venv-local/
ENV/
.mypy_cache/
.pytest_cache/
.coverage
htmlcov/
.tox/
*.egg-info/
dist/
build/

# ==========================================
# Node.js (Frontend)
# ==========================================
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.npm
.yarn

# ==========================================
# IDE & Editors
# ==========================================
.idea/
.vscode/
*.swp
*.swo
*~
*.sublime-project
*.sublime-workspace

# ==========================================
# Claude Code
# ==========================================
.claude/settings.local.json
.claude/
.worktrees/
.reviews/

# ==========================================
# OS Files
# ==========================================
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db
Desktop.ini

# ==========================================
# Data & Databases
# ==========================================
# Ignore database data files
*.db
*.duckdb
*.sqlite
*.sqlite3
*.bson
*.sql
*.rdb
chroma_db/
redis_data/

# Ignore data directory but allow init scripts
data/*
!data/mongodb-init/
!data/cassandra-init/
!data/dynamodb-init/
!data/clickhouse-init/
!data/oracle-init/
!data/trino-integration-etc/
!data/duckdb/
data/duckdb/*.duckdb

# ==========================================
# Logs
# ==========================================
*.log
logs/
*.log.*

# ==========================================
# Build Outputs
# ==========================================
dist/
build/
site/
*.egg-info/

# ==========================================
# Testing
# ==========================================
coverage/
.nyc_output/
test-results/

# ==========================================
# Docker (optional local overrides)
# ==========================================
docker-compose.override.yml

# ==========================================
# Backups
# ==========================================
backups/
*.bak
*.backup

# ==========================================
# Temporary Files
# ==========================================
tmp/
temp/
*.tmp
*.temp

# ==========================================
# Jupyter Notebooks
# ==========================================
.ipynb_checkpoints/

# ==========================================
# SSL Certificates (generated locally)
# ==========================================
nginx/ssl/*.crt
nginx/ssl/*.key
nginx/ssl/*.pem
backend/app/services/_future/

# ==========================================
# Test Validation Data
# ==========================================
# Large benchmark datasets (downloaded locally)
backend/tests/validation/bird_data/
backend/tests/validation/mongodb_data/natural-language-to-mongosh/
backend/tests/validation/reports/

# ==========================================
# Implementation Artifacts
# ==========================================
/*_COMPLETE.md
/*_SUMMARY.md
/*_REVIEW.md
/*_IMPLEMENTATION.md
/*_PLAN.md

# ==========================================
# Claude Code (local-only files)
# ==========================================
.claude/settings.local.json
